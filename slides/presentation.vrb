\frametitle{Termes normaux}
\adjustbox{scale=0.7,center}{%
			\begin{tikzcd}
			& \cdot \arrow[rd, no head] \arrow[ld, no head] &                                      &   &                          &    &      &                                               & \cdot \arrow[rd, no head] \arrow[ld, no head] &   \\
			f    &                                               & \cdot \arrow[ld, no head] \arrow[rd] &   & {} \arrow[r, Rightarrow] & {} &      & \cdot \arrow[rd, no head] \arrow[ld, no head] &                                               & g \\
			& \cdot \arrow[rd, no head] \arrow[ld, no head] &                                      & g &                          &    & id_x &                                               & f                                             &   \\
			id_y &                                               & id_y                                 &   &                          &    &      &                                               &                                               &
		\end{tikzcd}
	}
	
	\vspace{5pt}
	
	\par\noindent\rule{\textwidth}{0.4pt}
	
	\begin{center}
		\begin{prooftree}
			\infer0[(norm-id)]{\Gamma \vdash_{Norm} id_x : x \rightarrow x}
		\end{prooftree} \\
		\vspace{20pt}
		\begin{prooftree}
			\hypo[]{\Gamma \vdash_{Norm} f : x \rightarrow y}
			\hypo[]{g : y \rightarrow z \in \Gamma}
			\infer2[(norm-comp)]{\Gamma \vdash_{Norm} f \cdot g : x \rightarrow z}
		\end{prooftree}
	\end{center}
